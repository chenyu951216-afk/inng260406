APP_NAME=okx-ai-futures-live-autonomy
APP_ENV=production
TZ=Asia/Taipei

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_BASE_URL=https://www.okx.com
OKX_IS_DEMO=false

OPENAI_API_KEY=
GPT_MODEL=gpt-4.1
ENABLE_GPT_REFLECTION=true
ENABLE_DAILY_GPT_REVIEW=true
ENABLE_GPT_LIVE_CONTROL=true
GPT_LIVE_CONTROL_TOP_N=3
GPT_LIVE_CONTROL_MIN_CONFIDENCE=0.38
GPT_TIMEOUT_SEC=30
GPT_REASONING_EFFORT=medium
DAILY_REVIEW_MIN_TRADES=3
GPT_DELIBERATION_ROUNDS=3
GPT_REVIEW_TIMEZONE=Asia/Taipei

INSTRUMENT_TYPE=SWAP
PRIMARY_TIMEFRAME=15m
SCAN_TOP_N=50
SCAN_SYMBOL_INTERVAL_SEC=0.005
CANDLE_LIMIT=240
RUNTIME_LOOP_ENABLED=true
RUNTIME_LOOP_SLEEP_SEC=50

ENABLE_LIVE_EXECUTION=true
ENABLE_POSITION_SYNC=true
ENABLE_PROTECTIVE_ORDERS=true
ENABLE_POSITION_MANAGER=true
ENABLE_POSITION_LIFECYCLE=true
ENABLE_LIVE_CLOSE_SYNC=true

KILL_SWITCH=false
REQUIRE_CREDENTIALS_CHECK=true
REQUIRE_ACCOUNT_CONFIG_CHECK=true
REQUIRE_MAX_AVAIL_CHECK=true

MAX_LIVE_ENTRIES_PER_CYCLE=4
MAX_SIMULTANEOUS_ENTRIES=4
MARGIN_RESERVE_RATIO=0.8
MAX_OPEN_POSITIONS=10
MAX_TOTAL_RISK_PCT=0.6
MAX_CONSECUTIVE_LOSSES_BEFORE_PAUSE=10

MIN_TRADE_CONFIDENCE=0.53
MIN_WATCH_CONFIDENCE=0.42
HARD_STOP_LOSS_PCT=0.012
INITIAL_STOP_LOSS_ATR=1.8
INITIAL_TAKE_PROFIT_ATR=3.0

DEFAULT_LEVERAGE_MIN=5
DEFAULT_LEVERAGE_MAX=100
DEFAULT_MARGIN_PCT_MIN=0.001
DEFAULT_MARGIN_PCT_MAX=0.02
MIN_ORDER_NOTIONAL_USDT=10
MIN_MARGIN_FLOOR_USDT=0.1
EFFECTIVE_LEARNING_MIN_ABS_PNL_USDT=0.5
EFFECTIVE_LEARNING_MIN_MARGIN_RATIO=0.01
EFFECTIVE_LEARNING_FORCE_MAX_LEVERAGE=true
ENABLE_EXPLORATION_LIVE_ORDERS=false
EXPLORATION_CONFIDENCE_DELTA_WIN=0.03
EXPLORATION_CONFIDENCE_DELTA_LOSS=-0.03

TD_MODE=cross
FORCE_POS_SIDE_IN_NET_MODE=false
SET_LEVERAGE_BEFORE_ENTRY=true
SKIP_PROTECTIVE_IF_ENTRY_FAILED=true
PROTECT_PRICE_GUARD_ENABLED=true

AI_CONTROLS_ENTRY=true
AI_CONTROLS_SIZING=true
AI_CONTROLS_LEVERAGE=true
AI_CONTROLS_PROTECTION=true
AI_CONTROLS_EXIT=true
AI_CONTROLS_PARAMETER_ADAPTATION=true
AUTONOMY_REQUIRED_RATIO=1.0

DATA_DIR=/data
STATE_DIR=/data/state
SQLITE_DB_NAME=trading_data.db
UI_HOST=0.0.0.0
UI_PORT=8080
PORT=8080
